# --- SUPABASE CONFIGURATION ---
# The URL of your Supabase project (e.g., https://xyz.supabase.co)
SUPABASE_URL=your_supabase_project_url

# The Anon Key (Public) for restricted access (RLS enabled)
SUPABASE_KEY=your_supabase_anon_key

# The Service Role Key (Secret) for admin access (Bypass RLS)
# WARNING: Keep this secret! Only used for system logging and administration.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- SUPABASE S3 STORAGE CONFIGURATION (Integrated) ---
SUPABASE_S3_ENDPOINT=your_supabase_s3_endpoint
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=your_bucket_name
