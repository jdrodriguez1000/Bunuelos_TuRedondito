# --- PYTHON ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env
.pytest_cache/
.coverage
htmlcov/
tests/reports/tests_report_raw.json

# --- NODE.JS (DASHBOARD) ---
node_modules/
dist/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- DATA & DVC ---
# Ignorar los datos reales (Parquet) pero permitir metadatos de DVC
data/**/*.parquet
data/**/*.csv
data/**/*.json
!data/**/.gitignore
!data/**/*.dvc
!data/.gitkeep

# Excluir cache de DVC
.dvc/cache/
.dvc/tmp/

# --- SYSTEM & OTHERS ---
outputs/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
